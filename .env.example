NODE_ENV=development
PORT=8080
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://docker:docker@localhost:2508/comprehendme
REDIS_HOST=127.0.0.1
REDIS_PORT=6500
JWT_SECRET=change-me

AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
# Optional; defaults to APP_URL + /api/sessions/oauth/cb
AUTH0_CALLBACK_URL=
# In Auth0 → Application → Settings → Allowed Callback URLs, add BOTH:
#   http://localhost:3000/api/sessions/oauth/cb
#   http://127.0.0.1:3000/api/sessions/oauth/cb
#
# To skip the "Authorize App" screen (recommended):
# Auth0 Dashboard → Settings → General → API Authorization Settings
#   → enable "Allow Skipping User Consent for First Party Applications"
# Then mark your application as first-party in its settings.

RESEND_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Local dev: MinIO from docker compose (see README). Production: Cloudflare R2 S3 API endpoint + public custom domain or r2.dev URL.
BUCKET_ACCESS_KEY=minioadmin
BUCKET_SECRET_KEY=minioadmin
BUCKET_ENDPOINT=http://127.0.0.1:9000
BUCKET_PUBLIC_URL=http://127.0.0.1:9000/comprehendme
BUCKET_NAME=comprehendme

# https://aistudio.google.com/apikey — must start with AIza (not Iza)
GEMINI_API_KEY=
# Set true to simulate patient replies without calling Google (local dev)
AI_MOCK=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
