// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserPlan {
  FREE
  PREMIUM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum MessageStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum ReviewStatus {
  PENDING
  READY
  FAILED
}

model User {
  id        BigInt    @id
  googleId  String?   @unique
  name      String?
  email     String    @unique
  avatar    String?
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  college           String?
  referralSource    String?   @map("referral_source")
  onboardingCompleted Boolean @default(false) @map("onboarding_completed")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  streakCount    Int      @default(0) @map("streak_count")
  lastStreakDate DateTime? @map("last_streak_date") @db.Date
  plan           UserPlan @default(FREE)
  stripeCustomerId String? @unique @map("stripe_customer_id")

  sessions               Session[]
  chats                  Chat[]
  dailyStats             UserDailyStat[]
  messageReviews         MessageReview[]
  sentFriendRequests     Friendship[] @relation("sentFriendRequests")
  receivedFriendRequests Friendship[] @relation("receivedFriendRequests")

  @@map("users")
}

model UserDailyStat {
  userId    BigInt
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @db.Date
  minutes   Int      @default(0)
  messaged  Boolean  @default(false) @map("messaged")

  @@unique([userId, date])
  @@map("user_daily_stats")
}

model Friendship {
  id          BigInt @id
  requesterId BigInt
  requester   User   @relation("sentFriendRequests", fields: [requesterId], references: [id])
  addresseeId BigInt
  addressee   User   @relation("receivedFriendRequests", fields: [addresseeId], references: [id])

  status    FriendshipStatus @default(PENDING)
  requesterNickname String? @map("requester_nickname")
  addresseeNickname String? @map("addressee_nickname")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model Session {
  id        BigInt   @id
  ip        String
  os        String
  browser   String?
  userId    BigInt
  user      User     @relation(fields: [userId], references: [id])
  hash      String
  expiresAt DateTime @map("expires_at")

  @@map("sessions")
}

model Patient {
  id          BigInt     @id
  name        String
  gender      String
  problem     String     @db.Text
  age         Int
  nationality String
  difficulty  Difficulty
  chats       Chat[]

  @@map("patients")
}

model Chat {
  id        BigInt    @id
  userId    BigInt
  user      User      @relation(fields: [userId], references: [id])
  patientId BigInt
  patient   Patient   @relation(fields: [patientId], references: [id])
  title     String
  updatedAt DateTime  @updatedAt @map("updated_at")
  messages  Message[]
  endedAt   DateTime? @map("ended_at")
  pausedAt  DateTime? @map("paused_at")
  reviewStatus ReviewStatus? @map("review_status")
  reviewError  String?       @map("review_error")
  reviewedAt   DateTime?     @map("reviewed_at")
  report    Report?
  messageReviews MessageReview[]

  @@map("chats")
}

model Message {
  id     BigInt @id
  chatId BigInt
  chat   Chat   @relation(fields: [chatId], references: [id])
  role   String //"user" || "model"

  content String        @db.Text
  status  MessageStatus @default(DELIVERED)
  reviews MessageReview[]

  @@map("messages")
}

model Report {
  id      BigInt @id
  chatId  BigInt @unique
  chat    Chat   @relation(fields: [chatId], references: [id])
  content String @db.Text

  @@map("reports")
}

model MessageReview {
  id        BigInt       @id
  chatId    BigInt       @map("chat_id")
  chat      Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  messageId BigInt       @unique @map("message_id")
  message   Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    BigInt       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  moveNumber Int         @map("move_number")
  score      Int
  quality    String
  category   String
  feedback   String      @db.Text
  highlights Json
  improvements Json
  status     ReviewStatus @default(PENDING)
  errorMessage String?    @map("error_message")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([chatId, moveNumber])
  @@index([userId, chatId])
  @@map("message_reviews")
}
